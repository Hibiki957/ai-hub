# Documentation only. Do not put credentials here or commit a generated compose.env.
# Generate real paths and credentials: node deploy/setup.mjs --root /absolute/private/aihub
HUB_UID=<SERVICE_USER_UID>
HUB_GID=<SERVICE_USER_GID>
HUB_BIND_PORT=8787
HUB_DATA_PATH=/absolute/private/aihub/data
HUB_ACCESS_TOKEN_PATH=/absolute/private/aihub/secrets/hub_access_token
HUB_ENCRYPTION_KEY_PATH=/absolute/private/aihub/secrets/hub_encryption_key
HUB_PAPERCLIP_URL=https://<PAPERCLIP_HOST>
HUB_PAPERCLIP_COMPANY_ID=<YOUR_COMPANY_UUID>
# Authenticated Paperclip must use an explicitly authorized connection.
# Set HUB_PAPERCLIP_TOKEN_FILE inside the service and mount its 0600 secret file.
# Never reuse another application's session or subscription login.
# Direct Node startup also supports HUB_ACCESS_TOKEN and HUB_ENCRYPTION_KEY.
# Prefer *_FILE when supervised by Docker; never pass secrets in command arguments.
