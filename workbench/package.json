{
  "name": "aihub-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test server/*.test.mjs server/harnesses/*.test.mjs deploy/*.test.mjs",
    "setup": "node server/setup.mjs",
    "format": "prettier --write server web/src web/tests deploy",
    "format:check": "prettier --check server web/src web/tests deploy"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@xyflow/react": "12.12.0",
    "fastify": "5.12.7",
    "lucide-react": "1.60.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-rnd": "10.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
